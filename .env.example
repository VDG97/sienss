# Copiez ce fichier en .env pour le développement local avec des réglages
# proches de la production, ou définissez ces variables directement dans
# les réglages d'environnement de votre hébergeur (Railway, Render, etc.)
#
# NE JAMAIS committer un vrai fichier .env contenant de vraies valeurs
# secrètes dans un dépôt Git — voir .gitignore.

# Clé secrète Django — générez une vraie valeur en production, par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changez-moi-en-production-avec-une-vraie-cle-aleatoire

# False en production. Laisser True (ou omettre) en développement local.
DEBUG=False

# Domaines autorisés à servir l'application, séparés par des virgules.
ALLOWED_HOSTS=monsite.example.com,www.monsite.example.com

# Fournie automatiquement par Railway/Render lors de la création d'une base
# PostgreSQL. Format : postgres://utilisateur:motdepasse@hote:port/nom_base
# Si absente, l'application utilise SQLite (développement local uniquement).
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom_base

# Mettre à False uniquement si votre hébergeur gère déjà la redirection
# HTTPS en amont (rare) — sinon laisser True ou omettre.
SECURE_SSL_REDIRECT=True
